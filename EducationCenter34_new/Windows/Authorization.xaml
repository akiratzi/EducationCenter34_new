<Window x:Class="EducationCenter34_new.Windows.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EducationCenter34_new.Windows"
        mc:Ignorable="d"
    Title="Authorization" Height="443" Width="700" WindowStartupLocation="CenterScreen" SizeToContent="WidthAndHeight" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>


        <TextBlock Text="Логин"  Grid.Row="0"  Grid.Column="0"/>
        <TextBox Name="LoginTb" Grid.Row="0"  Grid.Column="1"/>

        <TextBlock Text="Пароль" Grid.Row="2"  Grid.Column="0"/>
        <PasswordBox Name="PasswordPb" Grid.Row="2"  Grid.Column="2"/>

        <CheckBox Name="IsRememberCb" Grid.Row="3"  Grid.Column="0" Click="CheckBox_Click"/>
        <TextBlock Text="Запомнить меня" Grid.Row="3"  Grid.Column="0" Grid.ColumnSpan="2" Margin="22,0,528,0"/>

        <Button Name="VBtn" Grid.Row="6"  Grid.Column="2" Content="Войти" Click="VBtn_Click"/>

    </Grid>

</Window>
